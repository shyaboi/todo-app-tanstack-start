#!/bin/sh
# Runs the same checks CI runs, before anything leaves the machine.
# Wired up automatically by the `prepare` script in package.json.
# Bypass in an emergency with `git push --no-verify`.
set -e

printf '\033[1mpre-push\033[0m running the CI gate locally...\n\n'

fail() {
  printf '\n\033[31mpre-push failed: %s\033[0m\n' "$1"
  printf 'Fix it, or re-run with --no-verify if you know what you are doing.\n'
  exit 1
}

printf '  typecheck... '   && npm run --silent typecheck    >/dev/null || fail 'typecheck'; printf 'ok\n'
printf '  lint...      '   && npm run --silent lint         >/dev/null || fail 'lint';      printf 'ok\n'
printf '  format...    '   && npm run --silent format:check >/dev/null || fail 'format (run: npm run format)'; printf 'ok\n'
printf '  unit tests...'   && npm run --silent test         >/dev/null || fail 'unit tests'; printf ' ok\n'

printf '\n\033[32mall checks passed\033[0m\n'
