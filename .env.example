# Copy to .env and fill in. .env is ignored and must never be committed.
#
# Atlas: Database Access -> a user with readWrite on this database only,
# not atlasAdmin. Network Access -> allow your IP.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database the app reads and writes. Collections are created on first use.
MONGODB_DB=tasker

# End-to-end runs use .env.e2e (also ignored) to point at a throwaway
# database, so tests never write to the one above:
#   MONGODB_DB=tasker_e2e
